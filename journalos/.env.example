# ============================================================================
# JournalOS — Free & Open Mindful Journaling Web App Configuration
# ============================================================================

# 1. Free Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
#    (You can also paste this directly inside the Web App Settings modal!)
GEMINI_API_KEY=""
GOOGLE_GENAI_USE_VERTEXAI=false

# 2. Free Google Sheets Database Webhook URL (Google Apps Script Web App URL)
#    Deploy `scripts/google_apps_script.gs` in any Google Sheet -> Extensions -> Apps Script
#    (You can also paste this directly inside the Web App Settings modal!)
GOOGLE_SHEETS_WEBHOOK_URL=""

# 3. Optional ZenQuotes API Key
ZENQUOTES_API_KEY=""
PORT=8080
